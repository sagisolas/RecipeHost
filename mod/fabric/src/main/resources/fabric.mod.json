{
  "schemaVersion": 1,
  "id": "recipehost",
  "version": "${version}",
  "name": "RecipeHost",
  "description": "Companion mod that streams recipes and icons to the RecipeHost mobile app.",
  "authors": [
    {
      "name": "${author}",
      "contact": {
        "email": "${authorEmail}"
      }
    }
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}"
  },
  "license": "MPL-2.0",
  "icon": "assets/recipehost/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.sagisolas.recipehost.mod.fabric.RecipeHostFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
