-- Items are keyed by (Mod release, item id). ordinal is the registry position in the last Scan.
-- id is an explicit rowid alias: item_fts points at it, and an implicit rowid may change on VACUUM.
CREATE TABLE item (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    release_id INTEGER NOT NULL,
    item_id TEXT NOT NULL,
    display_name TEXT NOT NULL,
    ordinal INTEGER NOT NULL,
    UNIQUE (release_id, item_id)
);

-- Full-text search over display names, kept in sync with item by the triggers below.
-- FTS4 rather than FTS5: older Android SQLite builds don't ship FTS5.
CREATE VIRTUAL TABLE item_fts USING fts4(content="item", display_name);

CREATE TRIGGER item_fts_after_insert AFTER INSERT ON item BEGIN
    INSERT INTO item_fts(docid, display_name) VALUES (new.id, new.display_name);
END;

CREATE TRIGGER item_fts_before_update BEFORE UPDATE ON item BEGIN
    DELETE FROM item_fts WHERE docid = old.id;
END;

CREATE TRIGGER item_fts_after_update AFTER UPDATE ON item BEGIN
    INSERT INTO item_fts(docid, display_name) VALUES (new.id, new.display_name);
END;

CREATE TRIGGER item_fts_before_delete BEFORE DELETE ON item BEGIN
    DELETE FROM item_fts WHERE docid = old.id;
END;

-- Skips unchanged rows, so a Scan that brings the same names doesn't churn item_fts.
update:
UPDATE item SET display_name = :displayName, ordinal = :ordinal
WHERE release_id = :releaseId AND item_id = :itemId
  AND (display_name != :displayName OR ordinal != :ordinal);

insertIfAbsent:
INSERT OR IGNORE INTO item(release_id, item_id, display_name, ordinal)
VALUES (:releaseId, :itemId, :displayName, :ordinal);

ofRelease:
SELECT * FROM item WHERE release_id = :releaseId ORDER BY ordinal;

searchNames:
SELECT item.* FROM item_fts JOIN item ON item.id = item_fts.docid
WHERE item_fts MATCH :query ORDER BY item.ordinal;

-- The Items of the selected releases: minecraft first, then the mods' order in their latest Scan, then ordinal.
-- Each filter is skipped when its parameter is NULL. modPrefix is compared with substr, not LIKE,
-- because mod ids contain '_', a LIKE wildcard. nameMatch is an FTS4 MATCH expression.
selected:
SELECT item.release_id, item.item_id, item.display_name, icon.png
FROM item
JOIN version_selection ON version_selection.release_id = item.release_id
JOIN mod_release ON mod_release.id = item.release_id
LEFT JOIN icon ON icon.release_id = item.release_id AND icon.item_id = item.item_id
WHERE (:modId IS NULL OR mod_release.mod_id = :modId)
  AND (:modPrefix IS NULL OR :modPrefix = substr(mod_release.mod_id, 1, length(:modPrefix)))
  AND (:nameMatch IS NULL OR item.id IN (SELECT docid FROM item_fts WHERE item_fts MATCH :nameMatch))
ORDER BY mod_release.mod_id != 'minecraft', mod_release.scan_position, mod_release.mod_id, item.ordinal;

-- The Item :itemId in the selected release of :modId, if that release has it.
selectedOf:
SELECT item.release_id, item.item_id, item.display_name, icon.png
FROM version_selection
JOIN item ON item.release_id = version_selection.release_id
LEFT JOIN icon ON icon.release_id = item.release_id AND icon.item_id = item.item_id
WHERE version_selection.mod_id = :modId AND item.item_id = :itemId;

clear:
DELETE FROM item;

-- Whether the Catalog holds anything; an empty one starts the app at Welcome.
count:
SELECT COUNT(*) FROM item;
