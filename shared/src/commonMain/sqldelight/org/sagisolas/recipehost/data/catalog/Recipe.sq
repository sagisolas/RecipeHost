-- A Recipe belongs to the Mod release of its id's namespace and is kept per Instance (ADR 0011).
-- body is the encoded wire Recipe; body_hash (SHA-256 of body) merges identical variants across Instances.
-- layout_key names its recipe_layout once a LayoutBatch has listed it; a recipe is inserted without one.
CREATE TABLE recipe (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    release_id INTEGER NOT NULL,
    recipe_id TEXT NOT NULL,
    instance_id INTEGER NOT NULL,
    type_id TEXT NOT NULL,
    body BLOB NOT NULL,
    body_hash BLOB NOT NULL,
    layout_key TEXT,
    UNIQUE (release_id, recipe_id, instance_id)
);

CREATE INDEX recipe_by_instance_release ON recipe(instance_id, release_id);

-- For deleting the layouts no recipe points at.
CREATE INDEX recipe_by_layout ON recipe(layout_key);

-- Every result item of a recipe.
CREATE TABLE recipe_output (
    recipe_pk INTEGER NOT NULL,
    item_id TEXT NOT NULL,
    PRIMARY KEY (recipe_pk, item_id)
);

CREATE INDEX recipe_output_by_item ON recipe_output(item_id);

-- Every alternative in every Slot of a recipe.
CREATE TABLE recipe_input (
    recipe_pk INTEGER NOT NULL,
    item_id TEXT NOT NULL,
    PRIMARY KEY (recipe_pk, item_id)
);

CREATE INDEX recipe_input_by_item ON recipe_input(item_id);

-- Child rows are deleted explicitly: foreign-key cascades need a per-connection pragma.
deleteOutputsOf:
DELETE FROM recipe_output WHERE recipe_pk IN (
    SELECT id FROM recipe WHERE instance_id = :instanceId AND release_id = :releaseId
);

deleteInputsOf:
DELETE FROM recipe_input WHERE recipe_pk IN (
    SELECT id FROM recipe WHERE instance_id = :instanceId AND release_id = :releaseId
);

deleteOf:
DELETE FROM recipe WHERE instance_id = :instanceId AND release_id = :releaseId;

insert:
INSERT INTO recipe(release_id, recipe_id, instance_id, type_id, body, body_hash)
VALUES (:releaseId, :recipeId, :instanceId, :typeId, :body, :bodyHash);

-- A recipe with its key chosen by the caller: a Scan's commit lets AUTOINCREMENT key its first
-- recipe and numbers the rest after it, so no key is ever reused and SQLite isn't asked each time.
insertWithPk:
INSERT INTO recipe(id, release_id, recipe_id, instance_id, type_id, body, body_hash)
VALUES (:pk, :releaseId, :recipeId, :instanceId, :typeId, :body, :bodyHash);

-- Points a recipe of one Instance and release at its layout; the layout row may not exist yet.
linkLayout:
UPDATE recipe SET layout_key = :layoutKey
WHERE instance_id = :instanceId AND release_id = :releaseId AND recipe_id = :recipeId;

lastInsertedId:
SELECT last_insert_rowid();

insertOutput:
INSERT OR IGNORE INTO recipe_output(recipe_pk, item_id) VALUES (:recipePk, :itemId);

insertInput:
INSERT OR IGNORE INTO recipe_input(recipe_pk, item_id) VALUES (:recipePk, :itemId);

ofInstance:
SELECT recipe.* FROM recipe JOIN instance ON instance.id = recipe.instance_id
WHERE instance.name = :instanceName ORDER BY recipe.recipe_id;

outputsOf:
SELECT item_id FROM recipe_output WHERE recipe_pk = :recipePk ORDER BY item_id;

inputsOf:
SELECT item_id FROM recipe_input WHERE recipe_pk = :recipePk ORDER BY item_id;

-- The recipes of the selected releases with a result of :itemId, one row per Instance, grouped
-- by type and recipe and, within one (release, recipe id), the most recently scanned Instance first.
-- The layout columns are null when the recipe has no layout, or its layout hasn't arrived.
-- type_name is the type's name under the selected release of its namespace, null when it has none.
selectedProducing:
SELECT recipe.release_id, recipe.recipe_id, recipe.type_id, recipe.body, recipe.body_hash, instance.name AS instance_name,
    recipe_layout.key AS layout_key, recipe_layout.width AS layout_width, recipe_layout.height AS layout_height,
    recipe_layout.slots AS layout_slots, recipe_type.name AS type_name
FROM recipe
LEFT JOIN recipe_layout ON recipe_layout.key = recipe.layout_key
LEFT JOIN recipe_type ON recipe_type.type_id = recipe.type_id
    AND recipe_type.release_id IN (SELECT release_id FROM version_selection)
JOIN version_selection ON version_selection.release_id = recipe.release_id
JOIN instance ON instance.id = recipe.instance_id
WHERE recipe.id IN (SELECT recipe_pk FROM recipe_output WHERE item_id = :itemId)
ORDER BY recipe.type_id, recipe.recipe_id, recipe.release_id, instance.last_scanned_at DESC, instance.name;

-- Like selectedProducing, for the recipes with :itemId among the alternatives of an input Slot.
selectedConsuming:
SELECT recipe.release_id, recipe.recipe_id, recipe.type_id, recipe.body, recipe.body_hash, instance.name AS instance_name,
    recipe_layout.key AS layout_key, recipe_layout.width AS layout_width, recipe_layout.height AS layout_height,
    recipe_layout.slots AS layout_slots, recipe_type.name AS type_name
FROM recipe
LEFT JOIN recipe_layout ON recipe_layout.key = recipe.layout_key
LEFT JOIN recipe_type ON recipe_type.type_id = recipe.type_id
    AND recipe_type.release_id IN (SELECT release_id FROM version_selection)
JOIN version_selection ON version_selection.release_id = recipe.release_id
JOIN instance ON instance.id = recipe.instance_id
WHERE recipe.id IN (SELECT recipe_pk FROM recipe_input WHERE item_id = :itemId)
ORDER BY recipe.type_id, recipe.recipe_id, recipe.release_id, instance.last_scanned_at DESC, instance.name;

clearOutputs:
DELETE FROM recipe_output;

clearInputs:
DELETE FROM recipe_input;

clear:
DELETE FROM recipe;
