-- One mod at one version for one Minecraft version (ADR 0010).
CREATE TABLE mod_release (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    mod_id TEXT NOT NULL,
    version TEXT NOT NULL,
    mc_version TEXT NOT NULL,
    name TEXT NOT NULL,
    -- The mod's position in the Handshake of the last Scan that carried this release (the order ItemSearch lists Items in).
    scan_position INTEGER NOT NULL,
    last_scanned_at INTEGER NOT NULL,
    UNIQUE (mod_id, version, mc_version)
);

-- Upserts are UPDATE + INSERT OR IGNORE: minSdk 24 ships SQLite 3.9, which has no ON CONFLICT DO UPDATE.
insertIfAbsent:
INSERT OR IGNORE INTO mod_release(mod_id, version, mc_version, name, scan_position, last_scanned_at)
VALUES (:modId, :version, :mcVersion, :name, :scanPosition, :lastScannedAt);

markScanned:
UPDATE mod_release SET name = :name, scan_position = :scanPosition, last_scanned_at = :lastScannedAt
WHERE mod_id = :modId AND version = :version AND mc_version = :mcVersion;

idOf:
SELECT id FROM mod_release WHERE mod_id = :modId AND version = :version AND mc_version = :mcVersion;

all:
SELECT * FROM mod_release ORDER BY id;

modOf:
SELECT mod_id FROM mod_release WHERE id = :releaseId;

-- Every release of the mods that add Items in any of their releases, with its mod's selected
-- release; a mod's releases come newest first. A mod that only owns recipes (a datapack) has
-- nothing to filter the item grid by, so it is left out.
withSelection:
SELECT mod_release.id, mod_release.mod_id, mod_release.version, mod_release.mc_version, mod_release.name,
       version_selection.release_id AS selected_release_id
FROM mod_release
LEFT JOIN version_selection ON version_selection.mod_id = mod_release.mod_id
WHERE mod_release.mod_id IN (
    SELECT with_items.mod_id FROM mod_release AS with_items
    WHERE EXISTS (SELECT 1 FROM item WHERE item.release_id = with_items.id)
)
ORDER BY mod_release.mod_id, mod_release.last_scanned_at DESC, mod_release.id DESC;

clear:
DELETE FROM mod_release;
