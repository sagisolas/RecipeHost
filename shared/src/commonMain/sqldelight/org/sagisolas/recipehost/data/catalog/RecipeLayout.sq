-- Recipe layouts as received (ADR 0015): a PNG of a recipe's GUI in GUI px, and its Recipe slots,
-- encoded as a RecipeLayout message that carries only its slots. Recipes point here by key.
-- A vanilla layout's key names its parameters, not its pixels, so a later Scan with another
-- resource pack or locale replaces the image under the same key: the latest Scan wins.
CREATE TABLE recipe_layout (
    key TEXT NOT NULL PRIMARY KEY,
    png BLOB NOT NULL,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    slots BLOB NOT NULL
);

upsert:
INSERT OR REPLACE INTO recipe_layout(key, png, width, height, slots) VALUES (:key, :png, :width, :height, :slots);

byKey:
SELECT * FROM recipe_layout WHERE key = :key;

pngOf:
SELECT png FROM recipe_layout WHERE key = :key;

-- Layouts no recipe points at any more, once a Scan has ended.
deleteUnreferenced:
DELETE FROM recipe_layout WHERE key NOT IN (SELECT layout_key FROM recipe WHERE layout_key IS NOT NULL);

count:
SELECT COUNT(*) FROM recipe_layout;

clear:
DELETE FROM recipe_layout;
